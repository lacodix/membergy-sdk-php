{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://membergy.app/schemas/cms/v1/event.schema.json",
  "title": "Membergy public event contract v1",
  "oneOf": [
    { "$ref": "#/definitions/detailResponse" },
    { "$ref": "#/definitions/collectionResponse" }
  ],
  "definitions": {
    "tag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1, "maxLength": 255 }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uuid", "title", "description", "url", "all_day", "start_date", "end_date",
        "start_at", "end_at", "timezone", "type", "visibility", "is_cancelled",
        "location_label", "location_lat", "location_lng", "tags"
      ],
      "properties": {
        "uuid": { "$ref": "common.schema.json#/definitions/uuid" },
        "title": { "type": "string", "minLength": 1, "maxLength": 500 },
        "description": { "$ref": "common.schema.json#/definitions/nullableString" },
        "url": { "$ref": "common.schema.json#/definitions/nullableString" },
        "all_day": { "type": "boolean" },
        "start_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "end_date": {
          "type": ["string", "null"],
          "format": "date"
        },
        "start_at": { "$ref": "common.schema.json#/definitions/nullableDateTime" },
        "end_at": { "$ref": "common.schema.json#/definitions/nullableDateTime" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 255 },
        "type": {
          "type": "string",
          "enum": [
            "rehearsal", "performance", "request_for_rehearsal",
            "request_for_performance", "meeting", "info", "others"
          ]
        },
        "visibility": {
          "type": "string",
          "enum": ["public", "members", "participants"]
        },
        "is_cancelled": { "type": "boolean" },
        "location_label": { "$ref": "common.schema.json#/definitions/nullableString" },
        "location_lat": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "location_lng": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "tags": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/definitions/tag" }
        }
      }
    },
    "collectionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data", "links", "meta"],
      "properties": {
        "data": {
          "type": "array",
          "items": { "$ref": "#/definitions/event" }
        },
        "links": {
          "type": "object",
          "additionalProperties": false,
          "required": ["first", "last", "prev", "next"],
          "properties": {
            "first": { "type": "null" },
            "last": { "type": "null" },
            "prev": { "type": ["string", "null"], "format": "uri" },
            "next": { "type": ["string", "null"], "format": "uri" }
          }
        },
        "meta": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "per_page", "next_cursor", "prev_cursor"],
          "properties": {
            "path": { "type": "string", "format": "uri" },
            "per_page": { "type": "integer", "minimum": 1, "maximum": 100 },
            "next_cursor": { "type": ["string", "null"] },
            "prev_cursor": { "type": ["string", "null"] }
          }
        }
      }
    },
    "detailResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "$ref": "#/definitions/event" }
      }
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://membergy.app/schemas/forms/v1/form.schema.json",
  "title": "Membergy public form contract v1",
  "oneOf": [
    { "$ref": "#/definitions/definitionResponse" },
    { "$ref": "#/definitions/submissionResponse" },
    { "$ref": "#/definitions/validationError" },
    { "$ref": "#/definitions/notFoundError" }
  ],
  "definitions": {
    "jsonValue": {
      "anyOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/jsonValue" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/jsonValue" }
        }
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": { "type": ["string", "integer"] },
        "label": { "type": "string" }
      }
    },
    "field": {
      "allOf": [{ "if": { "properties": { "type": { "const": "repeater" } } }, "then": { "required": ["fields", "max"] } }],
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "label",
        "type",
        "required",
        "nullable",
        "multiple",
        "default",
        "help",
        "options"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
        "label": { "type": "string" },
        "type": {
          "type": "string",
          "enum": [
            "text",
            "email",
            "password",
            "select",
            "checkbox",
            "date",
            "datetime",
            "number",
            "textarea",
            "repeater"
          ]
        },
        "required": { "type": "boolean" },
        "nullable": { "type": "boolean" },
        "multiple": { "type": "boolean" },
        "default": { "$ref": "#/definitions/jsonValue" },
        "help": { "type": ["string", "null"] },
        "options": {
          "type": "array",
          "items": { "$ref": "#/definitions/option" }
        },
        "fields": { "type": "array", "items": { "$ref": "#/definitions/field" } },
        "max": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "title", "fields", "values"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "type": ["string", "null"] },
        "fields": {
          "type": "array",
          "items": { "$ref": "#/definitions/field" }
        },
        "values": {
          "type": "object",
          "additionalProperties": { "$ref": "#/definitions/jsonValue" }
        }
      }
    },
    "definitionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": { "$ref": "#/definitions/definition" }
      }
    },
    "submissionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data"],
      "properties": {
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "string", "const": "submitted" }
          }
        }
      }
    },
    "validationError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "code", "errors"],
      "properties": {
        "message": { "type": "string", "const": "The submitted form values are invalid." },
        "code": { "type": "string", "const": "form_validation_failed" },
        "errors": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "notFoundError": {
      "type": "object",
      "additionalProperties": false,
      "required": ["message", "code"],
      "properties": {
        "message": { "type": "string", "const": "The requested form was not found." },
        "code": { "type": "string", "const": "form_not_found" }
      }
    }
  }
}
